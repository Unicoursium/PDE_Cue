# Copy this file to .env for local settings.
# The real .env file is ignored by git.

FIREBASE_SERVICE_ACCOUNT=C:\PDE_Files\AI_DJ\serviceAccountKey.json

AIDJ_CLEAR_AUTOMIX_ON_START=1
AIDJ_START_AUTOMIX=1

AIDJ_PROFILES_COLLECTION=profiles
AIDJ_PROFILE_STATUS=ONBOARDING_SUBMITTED
AIDJ_TRACK_FIELD=soundCloudTrack

VDJ_BASE_URL=http://127.0.0.1:8080
VDJ_BEARER_TOKEN=

AIDJ_SEARCH_TIMEOUT_SECONDS=15
AIDJ_SEARCH_POLL_INTERVAL_SECONDS=0.8
